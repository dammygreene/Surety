{
  "name": "surety",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Refundable accountability bonds for open submissions",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "dev": "tsx src/server.ts",
    "start": "node --import tsx src/server.ts",
    "check": "tsc --noEmit",
    "demo:import-live": "node --env-file=.env.local --import tsx scripts/import-live-evidence.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.13.4",
    "mppx": "^0.13.4",
    "viem": "^2.57.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
